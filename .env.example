# Copy this file to .env and fill in real values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=skillevate-cluster
MONGODB_DATABASE=skillevate_user
APP_NAME=Skillevate User Service
APP_ENV=development
# Include 127.0.0.1 if you open the MFE via http://127.0.0.1:* (Origin must match exactly).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

